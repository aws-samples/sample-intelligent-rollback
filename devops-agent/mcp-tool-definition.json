    {
      "name": "get_deployment_status",
      "title": "Get CodeDeploy deployment status",
      "description": "Read-only. Describe one AWS CodeDeploy deployment of the configured deployment group, or the newest one if deployment_id is omitted: status, create and complete times, description, rollback info, error information, and the traffic-shift overview. Safe to call during an investigation.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deployment_id": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11,
            "pattern": "^d-[A-Z0-9]{9}$",
            "description": "Optional CodeDeploy deployment ID, for example the Deployment ID line of the incident description. Must belong to the configured deployment group. If omitted, the newest deployment is described."
          },
          "application_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._+=,@-]{1,100}$",
            "description": "Optional. Must equal the CodeDeploy application this tool is configured for; any other value is rejected."
          },
          "deployment_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._+=,@-]{1,100}$",
