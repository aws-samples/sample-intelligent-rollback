{
    "family": "sample-app",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "<EXEC_ROLE_ARN>",
    "taskRoleArn": "<TASK_ROLE_ARN>",
    "containerDefinitions": [
        {
            "name": "sample-app",
            "image": "<IMAGE_URI>",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "PORT",
                    "value": "8080"
                },
                {
                    "name": "ERROR_RATE",
                    "value": "0.0"
                },
                {
                    "name": "LATENCY_MS",
                    "value": "0"
                },
                {
                    "name": "SERVICE_NAME",
                    "value": "sample-app"
                },
                {
                    "name": "CLOUDWATCH_NAMESPACE",
                    "value": "IntelligentRollback"
                },
                {
                    "name": "APP_VERSION",
                    "value": "1.0.0"
                },
                {
                    "name": "AWS_REGION",
                    "value": "<AWS_REGION>"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/sample-app",
                    "awslogs-region": "<AWS_REGION>",
                    "awslogs-stream-prefix": "ecs",
                    "awslogs-create-group": "true"
                }
            },
            "healthCheck": {
                "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8080/health')\" || exit 1"],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 15
            }
        }
    ]
}
