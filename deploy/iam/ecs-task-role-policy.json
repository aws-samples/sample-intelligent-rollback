{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PublishSampleMetrics",
            "Effect": "Allow",
            "Action": "cloudwatch:PutMetricData",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "cloudwatch:namespace": "IntelligentRollback"
                }
            }
        },
        {
            "Sid": "ReadDependencyFailureRate",
            "Effect": "Allow",
            "Action": "ssm:GetParameter",
            "Resource": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/<PROJECT_NAME>/dependency-failure-rate"
        }
    ]
}
