{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "InvokeMcpEndpoint",
            "Effect": "Allow",
            "Action": "execute-api:Invoke",
            "Resource": [
                "arn:aws:execute-api:<AWS_REGION>:<AWS_ACCOUNT_ID>:<API_ID>/v1/POST/mcp",
                "arn:aws:execute-api:<AWS_REGION>:<AWS_ACCOUNT_ID>:<API_ID>/v1/GET/mcp",
                "arn:aws:execute-api:<AWS_REGION>:<AWS_ACCOUNT_ID>:<API_ID>/v1/DELETE/mcp"
            ]
        }
    ]
}
