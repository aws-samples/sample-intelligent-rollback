{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "CodeDeployReadOnlyScoped",
            "Effect": "Allow",
            "Action": [
                "codedeploy:GetDeployment",
                "codedeploy:BatchGetDeployments",
                "codedeploy:ListDeployments"
            ],
            "Resource": [
                "arn:aws:codedeploy:<AWS_REGION>:<AWS_ACCOUNT_ID>:deploymentgroup:<CODEDEPLOY_APP_NAME>/<CODEDEPLOY_DG_NAME>",
                "arn:aws:codedeploy:<AWS_REGION>:<AWS_ACCOUNT_ID>:application:<CODEDEPLOY_APP_NAME>"
            ]
        },
        {
            "Sid": "ReadWebhookSecretParameter",
            "Effect": "Allow",
            "Action": "ssm:GetParameter",
            "Resource": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/<PROJECT_NAME>/webhook-secret"
        },
        {
            "Sid": "PublishInvestigatingNotice",
            "Effect": "Allow",
            "Action": "sns:Publish",
            "Resource": "arn:aws:sns:<AWS_REGION>:<AWS_ACCOUNT_ID>:<SNS_TOPIC_NAME>"
        },
        {
            "Sid": "SendToDeadLetterQueue",
            "Effect": "Allow",
            "Action": "sqs:SendMessage",
            "Resource": "arn:aws:sqs:<AWS_REGION>:<AWS_ACCOUNT_ID>:<DLQ_NAME>"
        },
        {
            "Sid": "WriteOwnLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:<AWS_REGION>:<AWS_ACCOUNT_ID>:log-group:/aws/lambda/webhook-forwarder:log-stream:*"
        }
    ]
}
